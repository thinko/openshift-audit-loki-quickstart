# Environment-specific overrides for make targets.
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# .env and .env.* are gitignored — safe for cluster-specific settings.
# For GitOps/ArgoCD, use Helm values instead (see helm/audit-loki/values.yaml).

# ── Grafana ──────────────────────────────────────────────────────────
# Container image for the standalone Grafana deployment.
# On clusters with registry restrictions, use a Nexus/Artifactory proxy.
# GRAFANA_IMAGE=nexus.example.com:8081/grafana/grafana:latest
GRAFANA_IMAGE=grafana/grafana:latest

# ── Namespaces (rarely need changing) ────────────────────────────────
# NAMESPACE=openshift-logging
# LOKI_NAMESPACE=openshift-logging
# OPERATORS_NAMESPACE=openshift-operators-redhat

# ── LokiStack ────────────────────────────────────────────────────────
# LOKISTACK_NAME=logging-loki
# CLF_NAME=loki-audit
# SECRET_NAME=logging-loki-azure

# ── Azure Blob Storage ──────────────────────────────────────────────
# These are only needed for `make deploy` if the secret doesn't exist yet.
# Prefer `make azure-storage` which writes .env.azure, or create the
# secret out-of-band and set azure.existingSecret in Helm values.
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_CONTAINER_NAME=loki-audit
# AZURE_ENVIRONMENT=AzureGlobal
