  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Security Alerts",
      "type": "row"
    },
    {
      "datasource": "Loki (Audit)",
      "description": "RBAC role and binding mutations \u2014 role/clusterrole/binding create, update, patch, delete events",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "editorMode": "code",
          "expr": "{log_type=\"audit\"} |~ \"(role|clusterrole)\" | json | objectRef_resource=~\"(roles|clusterroles|rolebindings|clusterrolebindings)\" | verb=~\"(create|update|patch|delete)\" | line_format \"{{.verb | ToUpper}} {{.objectRef_resource}}/{{.objectRef_name}} in {{.objectRef_namespace}} by {{.user_username}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "RBAC Changes",
      "type": "logs"
    },
    {
      "datasource": "Loki (Audit)",
      "description": "Pod exec and attach events \u2014 interactive shell access to running containers",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "editorMode": "code",
          "expr": "{log_type=\"audit\"} |~ \"(exec|attach)\" | json | objectRef_subresource=~\"(exec|attach)\" | line_format \"SHELL: {{.user_username}} -> pod/{{.objectRef_name}} in {{.objectRef_namespace}} [{{.responseStatus_code}}]\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Pod Exec / Attach",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 101,
      "title": "Access Patterns",
      "type": "row"
    },
    {
      "datasource": "Loki (Audit)",
      "description": "All 403 Forbidden responses \u2014 failed authorization attempts",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 3,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "editorMode": "code",
          "expr": "{log_type=\"audit\"} | json | responseStatus_code=\"403\" | line_format \"DENIED: {{.user_username}} tried to {{.verb}} {{.objectRef_resource}}/{{.objectRef_name}} in {{.objectRef_namespace}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Failed Authorization (403s)",
      "type": "logs"
    },
    {
      "datasource": "Loki (Audit)",
      "description": "Non-system users accessing secrets \u2014 excludes system:* service accounts",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 4,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "editorMode": "code",
          "expr": "{log_type=\"audit\"} |~ \"secrets\" | json | objectRef_resource=\"secrets\" | verb=~\"(get|list|create|update|patch|delete)\" | user_username!~\"system:.*\" | line_format \"{{.verb | ToUpper}} {{.objectRef_namespace}}/{{.objectRef_name}} by {{.user_username}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Secret Access by Humans",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 102,
      "title": "Activity Analysis",
      "type": "row"
    },
    {
      "datasource": "Loki (Audit)",
      "description": "Count of mutation events (create/update/patch/delete) over 5-minute windows",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "drawStyle": "bars",
            "barAlignment": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 19
      },
      "id": 5,
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "hidden"
        }
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "editorMode": "code",
          "expr": "sum(count_over_time({log_type=\"audit\"} |~ \"(create|update|patch|delete)\" | json | verb=~\"(create|update|patch|delete)\" [$__interval]))",
          "legendFormat": "mutations/5m",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Activity Histogram",
      "type": "timeseries",
      "interval": "5m"
    },
    {
      "datasource": "Loki (Audit)",
      "description": "Distribution of audit events by API verb over the last hour",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "id": 6,
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "percent",
            "value"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "editorMode": "code",
          "expr": "sum by (verb) (count_over_time({log_type=\"audit\"} | json [$__interval]))",
          "legendFormat": "{{verb}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Events by Verb",
      "type": "piechart",
      "interval": "5m"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 103,
      "title": "Compliance",
      "type": "row"
    },
    {
      "datasource": "Loki (Audit)",
      "description": "Successful resource deletions by non-system users",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "id": 7,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "editorMode": "code",
          "expr": "{log_type=\"audit\"} |~ \"delete\" | json | verb=\"delete\" | responseStatus_code=\"200\" | user_username!~\"system:.*\" | line_format \"{{.user_username}} deleted {{.objectRef_resource}}/{{.objectRef_name}} in {{.objectRef_namespace}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Resource Deletions by Humans",
      "type": "logs"
    },
    {
      "datasource": "Loki (Audit)",
      "description": "Detects: (1) any API request using impersonation (--as), (2) human users creating/modifying cluster-level RBAC roles and bindings. Both are privilege escalation vectors.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "id": 8,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "refId": "A",
          "expr": "{log_type=\"audit\"} |~ \"impersonatedUser\" | json | impersonatedUser_username!=\"\" | line_format \"IMPERSONATE {{.user_username}} acting as {{.impersonatedUser_username}}: {{.verb}} {{.objectRef_resource}} [{{.responseStatus_code}}]\"",
          "legendFormat": ""
        },
        {
          "datasource": "Loki (Audit)",
          "refId": "B",
          "expr": "{log_type=\"audit\"} |~ \"(clusterrole|clusterrolebinding)\" | json | verb=~\"(create|update|patch)\" | objectRef_resource=~\"(clusterroles|clusterrolebindings)\" | user_username!~\"system:.*\" | line_format \"RBAC-GRANT {{.verb | ToUpper}} {{.objectRef_resource}}/{{.objectRef_name}} by {{.user_username}} [{{.responseStatus_code}}]\"",
          "legendFormat": ""
        }
      ],
      "title": "Privilege Escalation & Impersonation",
      "type": "logs"
    }
  ],
