      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Critical Events",
      "type": "row"
    },
    {
      "datasource": "Loki (Infrastructure)",
      "description": "OOM killed events across infrastructure \u2014 containers killed due to memory limits",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Infrastructure)",
          "editorMode": "code",
          "expr": "{log_type=\"infrastructure\"} |~ \"(OOMKilled|Killed process|oom-kill)\" | line_format \"{{.kubernetes_namespace_name}}/{{.kubernetes_pod_name}}: {{.message}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "OOM Kills",
      "type": "logs"
    },
    {
      "datasource": "Loki (Infrastructure)",
      "description": "Containers stuck in CrashLoopBackOff restart cycles",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Infrastructure)",
          "editorMode": "code",
          "expr": "{log_type=\"infrastructure\"} |= \"CrashLoopBackOff\" | line_format \"{{.kubernetes_namespace_name}}/{{.kubernetes_pod_name}}: {{.message}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "CrashLoopBackOff",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 101,
      "title": "Operator & Platform Health",
      "type": "row"
    },
    {
      "datasource": "Loki (Infrastructure)",
      "description": "Error logs from openshift-* operator namespaces, excluding health check noise",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Infrastructure)",
          "editorMode": "code",
          "expr": "{log_type=\"infrastructure\", kubernetes_namespace_name=~\"openshift-.*\"} |= \"error\" |!= \"healthz\" |!= \"readyz\" | line_format \"{{.kubernetes_namespace_name}}/{{.kubernetes_container_name}}: {{.message}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Operator Errors",
      "type": "logs"
    },
    {
      "datasource": "Prometheus",
      "description": "Top 10 pods by container restart rate over the last hour",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "restarts/hr",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "topk(10, sum by (namespace, pod) (rate(kube_pod_container_status_restarts_total[1h]) * 3600))",
          "legendFormat": "{{namespace}}/{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Container Restart Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 102,
      "title": "Volume & Trends",
      "type": "row"
    },
    {
      "datasource": "Loki (Infrastructure)",
      "description": "Infrastructure log volume broken down by originating namespace",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 17
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "Loki (Infrastructure)",
          "editorMode": "code",
          "expr": "sum by (kubernetes_namespace_name) (count_over_time({log_type=\"infrastructure\"} [5m]))",
          "legendFormat": "{{kubernetes_namespace_name}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Infra Log Volume by Namespace",
      "type": "timeseries"
    },
    {
      "datasource": "Loki (Infrastructure)",
      "description": "etcd warnings \u2014 slow requests, leader changes, overloaded, latency issues",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "id": 6,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Infrastructure)",
          "editorMode": "code",
          "expr": "{log_type=\"infrastructure\", kubernetes_namespace_name=\"openshift-etcd\"} |~ \"(slow|leader|overloaded|took too long)\" | line_format \"{{.kubernetes_pod_name}}: {{.message}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "etcd Warnings",
      "type": "logs"
    }
  ],
