    {
      "datasource": "Loki (Audit)",
      "description": "Combined security event feed \u2014 RBAC changes, exec/attach, privilege escalation",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 15
