      "id": 9,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      },
      "targets": [
        {
          "datasource": "Loki (Audit)",
          "editorMode": "code",
          "expr": "{log_type=\"audit\"} |~ \"(rolebinding|clusterrole|exec|attach|bind|escalate|impersonate)\" | json | verb=~\"(create|update|patch|delete|bind|escalate|impersonate)\" | line_format \"{{.verb | ToUpper}} {{.objectRef_resource}}/{{.objectRef_name}} by {{.user_username}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Security Event Feed",
      "type": "logs"
    },
    {
      "datasource": "Loki (Audit)",
