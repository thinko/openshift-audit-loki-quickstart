{
  "annotations": { "list": [] },
  "description": "Audit log pipeline: edge filter effectiveness, LokiStack ingestion, collector health, storage utilization.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pipeline Overview",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "title": "Edge Filter Effectiveness",
      "description": "Audit events dropped by edge filters. 0.97 = 97% noise removed.",
      "type": "singlestat",
      "format": "percentunit",
      "decimals": 1,
      "sparkline": { "show": true, "full": true },
      "colorBackground": true,
      "thresholds": "0.80,0.90",
      "colors": ["#d44a3a", "#ff9830", "#299c46"],
      "targets": [
        {
          "expr": "1 - clamp_min(sum(rate(loki_distributor_lines_received_total{namespace=\"openshift-logging\"}[5m])) / sum(rate(apiserver_audit_event_total[5m])), 0)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "title": "Lines Ingested / min",
      "description": "Audit log lines arriving in Loki after edge filtering.",
      "type": "singlestat",
      "format": "short",
      "decimals": 0,
      "sparkline": { "show": true, "full": true },
      "colorBackground": false,
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_lines_received_total{namespace=\"openshift-logging\"}[5m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "title": "Bytes / sec",
      "description": "Byte rate into LokiStack.",
      "type": "singlestat",
      "format": "Bps",
      "sparkline": { "show": true, "full": true },
      "colorBackground": false,
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_bytes_received_total{namespace=\"openshift-logging\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "title": "Active Streams",
      "description": "Log streams held in Loki ingesters.",
      "type": "singlestat",
      "format": "short",
      "decimals": 0,
      "sparkline": { "show": true, "full": true },
      "colorBackground": false,
      "targets": [
        {
          "expr": "sum(loki_ingester_memory_streams{namespace=\"openshift-logging\"})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Ingestion",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 6 },
      "id": 10,
      "title": "API Server Events vs Loki Ingested (the gap = filter savings)",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 2,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "short", "label": "events / min", "show": true, "min": 0 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "avg": true, "current": true, "rightSide": false },
      "seriesOverrides": [
        { "alias": "API server total/min", "color": "#FF9830", "fill": 0, "linewidth": 3 },
        { "alias": "Loki ingested/min", "color": "#73BF69", "fill": 3 }
      ],
      "targets": [
        {
          "expr": "sum(rate(apiserver_audit_event_total[5m])) * 60",
          "legendFormat": "API server total/min",
          "refId": "A"
        },
        {
          "expr": "sum(rate(loki_distributor_lines_received_total{namespace=\"openshift-logging\"}[5m])) * 60",
          "legendFormat": "Loki ingested/min",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "id": 11,
      "title": "Ingestion Byte Rate",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 2,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "Bps", "label": "", "show": true, "min": 0 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "current": true },
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_bytes_received_total{namespace=\"openshift-logging\"}[5m]))",
          "legendFormat": "bytes/s",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "title": "Collector Pipeline (Vector)",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 14, "x": 0, "y": 14 },
      "id": 20,
      "title": "Collector: Received vs Sent (gap = filtered noise)",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "ops", "label": "events / sec", "show": true, "min": 0 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "avg": true, "current": true },
      "seriesOverrides": [
        { "alias": "received/s", "color": "#FF9830", "linewidth": 2 },
        { "alias": "sent/s (post-filter)", "color": "#73BF69", "linewidth": 2 }
      ],
      "targets": [
        {
          "expr": "sum(rate(vector_component_received_events_total{namespace=\"openshift-logging\"}[5m]))",
          "legendFormat": "received/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(vector_component_sent_events_total{namespace=\"openshift-logging\"}[5m]))",
          "legendFormat": "sent/s (post-filter)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 10, "x": 14, "y": 14 },
      "id": 21,
      "title": "Collector Buffer",
      "description": "Sustained growth = backpressure from Loki.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null as zero",
      "yaxes": [
        { "format": "short", "label": "buffered events", "show": true, "min": 0 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true },
      "targets": [
        {
          "expr": "sum by (pod) (vector_buffer_events{namespace=\"openshift-logging\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "title": "Loki Health",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 22 },
      "id": 30,
      "title": "Request Latency (p99)",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "s", "label": "", "show": true, "min": 0 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": false },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(loki_request_duration_seconds_bucket{namespace=\"openshift-logging\", route!=\"metrics\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 22 },
      "id": 31,
      "title": "Errors by Route",
      "description": "Non-2xx Loki responses. Sustained errors = investigate.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "stack": true,
      "nullPointMode": "null as zero",
      "yaxes": [
        { "format": "ops", "label": "errors / sec", "show": true, "min": 0 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true },
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(loki_request_duration_seconds_count{namespace=\"openshift-logging\", status_code!~\"2..\"}[5m]))",
          "legendFormat": "{{route}} [{{status_code}}]",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 },
      "id": 32,
      "title": "Component Memory",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "bytes", "label": "", "show": true, "min": 0 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"openshift-logging\", pod=~\"logging-loki-ingester.*\", container!=\"POD\", container!=\"\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"openshift-logging\", pod=~\"logging-loki-(compactor|querier|distributor|query-frontend|index-gateway|gateway).*\", container!=\"POD\", container!=\"\"})",
          "legendFormat": "{{pod}}",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 104,
      "title": "Storage",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "id": 40,
      "title": "PVC Usage (% Full)",
      "description": "Yellow 75%, red 90%.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "percentunit", "label": "", "show": true, "min": 0, "max": 1 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "current": true },
      "thresholds": [
        { "value": 0.75, "colorMode": "warning", "op": "gt", "fill": false, "line": true },
        { "value": 0.90, "colorMode": "critical", "op": "gt", "fill": false, "line": true }
      ],
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"openshift-logging\", persistentvolumeclaim=~\".*loki.*\"} / kubelet_volume_stats_capacity_bytes{namespace=\"openshift-logging\", persistentvolumeclaim=~\".*loki.*\"}",
          "legendFormat": "{{persistentvolumeclaim}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "id": 41,
      "title": "Azure Blob I/O",
      "description": "Object storage operations to Azure Blob backend.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null as zero",
      "yaxes": [
        { "format": "Bps", "label": "", "show": true, "min": 0 },
        { "format": "s", "label": "latency", "show": true }
      ],
      "legend": { "show": true, "alignAsTable": true, "current": true },
      "targets": [
        {
          "expr": "sum(rate(loki_azure_blob_egress_bytes_total{namespace=\"openshift-logging\"}[5m]))",
          "legendFormat": "egress bytes/s",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loki_azure_blob_request_duration_seconds_bucket{namespace=\"openshift-logging\"}[5m])))",
          "legendFormat": "request latency p99",
          "refId": "B",
          "yaxis": 2
        }
      ]
    }
  ],
  "schemaVersion": 16,
  "tags": ["loki", "audit", "openshift", "logging"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Audit LokiStack Overview",
  "uid": "audit-loki-overview",
  "version": 3
}
