{
  "annotations": { "list": [] },
  "description": "Audit log pipeline: LokiStack ingestion, edge filter effectiveness, collector metrics, and storage.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pipeline Overview",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "title": "Edge Filter Effectiveness",
      "description": "Percentage of audit events dropped by edge filters. Higher = less noise stored.",
      "type": "singlestat",
      "format": "percentunit",
      "sparkline": { "show": true, "full": false },
      "colorBackground": true,
      "thresholds": "0.80,0.90",
      "colors": ["#d44a3a", "#ff9830", "#299c46"],
      "targets": [
        {
          "expr": "1 - clamp_min(sum(rate(loki_distributor_lines_received_total{namespace=\"openshift-logging\"}[5m])) / sum(rate(apiserver_audit_event_total[5m])), 0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "title": "Audit Lines Ingested / min",
      "description": "Rate of audit log lines arriving in LokiStack after edge filtering.",
      "type": "singlestat",
      "format": "short",
      "sparkline": { "show": true, "full": false },
      "colorBackground": false,
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_lines_received_total{namespace=\"openshift-logging\"}[5m])) * 60",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "title": "Bytes Ingested / sec",
      "description": "Byte rate into LokiStack.",
      "type": "singlestat",
      "format": "Bps",
      "sparkline": { "show": true, "full": false },
      "colorBackground": false,
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_bytes_received_total{namespace=\"openshift-logging\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "title": "Active Streams",
      "description": "Number of active log streams in Loki ingesters.",
      "type": "singlestat",
      "format": "short",
      "sparkline": { "show": true, "full": false },
      "colorBackground": false,
      "targets": [
        {
          "expr": "sum(loki_ingester_memory_streams{namespace=\"openshift-logging\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Ingestion Over Time",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 10,
      "title": "Audit Events: API Server vs Loki Ingested",
      "description": "Compare total audit events generated vs what Loki stores. The gap = edge filter savings.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "short", "label": "events/min", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "avg": true, "current": true, "max": true },
      "targets": [
        {
          "expr": "sum(rate(apiserver_audit_event_total[5m])) * 60",
          "legendFormat": "API server total/min",
          "refId": "A"
        },
        {
          "expr": "sum(rate(loki_distributor_lines_received_total{namespace=\"openshift-logging\"}[5m])) * 60",
          "legendFormat": "Loki ingested/min (after filters)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 11,
      "title": "Loki Ingestion Byte Rate",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "Bps", "label": "", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "avg": true, "current": true, "max": true },
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_bytes_received_total{namespace=\"openshift-logging\"}[5m]))",
          "legendFormat": "bytes/s ingested",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "Collector Pipeline (Vector)",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 20,
      "title": "Collector: Received vs Sent Events",
      "description": "Events received before filtering vs events sent to Loki after. The gap is filtered noise.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "ops", "label": "events/sec", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "avg": true, "current": true },
      "targets": [
        {
          "expr": "sum(rate(vector_component_received_events_total{namespace=\"openshift-logging\"}[5m]))",
          "legendFormat": "received/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(vector_component_sent_events_total{namespace=\"openshift-logging\"}[5m]))",
          "legendFormat": "sent/s (post-filter)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 21,
      "title": "Collector Buffer Utilization",
      "description": "Sustained growth = backpressure from Loki.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "short", "label": "buffered events", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true },
      "targets": [
        {
          "expr": "sum by (pod) (vector_buffer_events{namespace=\"openshift-logging\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103,
      "title": "Loki Health",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 30,
      "title": "Loki Request Latency (p99)",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "s", "label": "latency", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "current": true, "max": true },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(loki_request_duration_seconds_bucket{namespace=\"openshift-logging\", route=~\"/loki/api/v1.*\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 31,
      "title": "Loki Errors by Route",
      "description": "Non-2xx Loki responses. Sustained errors = unhealthy components.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "stack": true,
      "nullPointMode": "null as zero",
      "yaxes": [
        { "format": "ops", "label": "errors/sec", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "current": true },
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(loki_request_duration_seconds_count{namespace=\"openshift-logging\", status_code!~\"2..\"}[5m]))",
          "legendFormat": "{{route}} [{{status_code}}]",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "id": 32,
      "title": "Ingester Memory Usage",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "bytes", "label": "", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"openshift-logging\", container=\"loki\", pod=~\"logging-loki-ingester.*\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "id": 33,
      "title": "Compactor / Querier Memory",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "bytes", "label": "", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"openshift-logging\", container=\"loki\", pod=~\"logging-loki-(compactor|querier).*\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 104,
      "title": "Storage",
      "type": "row"
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "id": 40,
      "title": "PVC Usage (% Full)",
      "description": "Loki PVC utilization. Yellow 75%, red 90%.",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "percentunit", "label": "", "show": true, "min": 0, "max": 1 },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "current": true },
      "thresholds": [
        { "value": 0.75, "colorMode": "warning", "op": "gt", "fill": false, "line": true },
        { "value": 0.90, "colorMode": "critical", "op": "gt", "fill": false, "line": true }
      ],
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"openshift-logging\", persistentvolumeclaim=~\".*loki.*\"} / kubelet_volume_stats_capacity_bytes{namespace=\"openshift-logging\", persistentvolumeclaim=~\".*loki.*\"}",
          "legendFormat": "{{persistentvolumeclaim}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "id": 41,
      "title": "PVC Used Bytes",
      "type": "graph",
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "nullPointMode": "null",
      "yaxes": [
        { "format": "bytes", "label": "", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true, "current": true },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"openshift-logging\", persistentvolumeclaim=~\".*loki.*\"}",
          "legendFormat": "{{persistentvolumeclaim}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 16,
  "tags": ["loki", "audit", "openshift", "logging"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Audit LokiStack Overview",
  "uid": "audit-loki-overview",
  "version": 2
}
