      "targets": [
        {
          "datasource": "Loki (Infrastructure)",
          "expr": "{log_type=\"infrastructure\"} |~ \"(?i)(kernel|hardware|mce|edac)\" |~ \"(?i)(warn|error|fail|critical)\" | json message=\"message\", host=\"hostname\" | line_format \"{{.host}}: {{.message}}\"",
