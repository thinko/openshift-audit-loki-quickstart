      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "topk(10, sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h])))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "title": "Pod Restarts Top 10",
      "type": "table",
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "Pending": {
                  "text": "Pending",
                  "color": "yellow",
                  "index": 0
                },
                "Failed": {
                  "text": "Failed",
                  "color": "red",
                  "index": 1
                },
                "Unknown": {
                  "text": "Unknown",
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "phase"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background-solid"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 10,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "namespace",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"} == 1",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "title": "Pods Not Running",
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "service": true,
              "uid": true
            },
            "indexByName": {},
            "renameByName": {}
          }
